{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/habolanos/devsecops-process-tracker/schemas/v1/process.schema.json",
  "title": "DevSecOps Process YAML",
  "description": "Schema for process definition files consumed by parseYAMLToProcess in lib/yaml-parser.ts. Authoritative contract for YAML authors; the parser is intentionally more lenient on defaults.",
  "$comment": "Schema version: 1.2.0 - Last synced with develop on 2026-04-23. Covers: 8 task types (standard, check, multicheck, export-excel, dynamic-list, detail-list, detail-table, form), declarative Excel export with sheets[] architecture (process.export), outputVars, optionsFrom, sourceVar, kind:range, kind:cell, kind:detail-table, completionAlert dialogs, subprocesses (github/url/local), activity-level dynamicLinks and images, process variables with select/number/text types.",
  "type": "object",
  "additionalProperties": false,
  "required": ["process"],
  "properties": {
    "process": { "$ref": "#/$defs/Process" }
  },

  "$defs": {
    "CellRef": {
      "type": "string",
      "pattern": "^[A-Z]+[0-9]+$",
      "description": "Excel cell reference in A1 notation (e.g. 'F85', 'AA10')."
    },

    "ColumnLetter": {
      "type": "string",
      "pattern": "^[A-Z]+$",
      "description": "Excel column letter(s) only (e.g. 'F', 'AA')."
    },

    "Duration": {
      "type": "string",
      "pattern": "^(\\d+(?:\\.\\d+)?[hms])+$",
      "examples": ["45m", "1h30m", "2h", "4h", "1.5h", "30s"],
      "description": "Human-readable duration composed of h (hours), m (minutes) or s (seconds) segments. Decimal values are allowed (e.g. '1.5h'). Segments are additive: '1h30m' = 90 minutes. Parsed by parseTimeString in lib/helpers.ts. Days ('d') are NOT supported by the parser."
    },

    "Identifier": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier used for cross-references (dependencies, sourceTaskId)."
    },

    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url":   { "type": "string", "format": "uri" }
      }
    },

    "EvidenceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {
          "enum": ["text", "image", "both", "form", "none"],
          "description": "What kind of evidence the task accepts."
        },
        "required":    { "type": "boolean" },
        "description": { "type": "string" }
      }
    },

    "DynamicLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "urlTemplate", "behavior"],
      "properties": {
        "label":       { "type": "string", "minLength": 1 },
        "urlTemplate": {
          "type": "string",
          "minLength": 1,
          "description": "URL with {variable} placeholders resolved against capturedVariables."
        },
        "behavior": {
          "enum": ["auto", "click"],
          "description": "auto = opens when variables become available; click = manual activation."
        },
        "delay":             { "type": "number", "minimum": 0 },
        "newTab":            { "type": "boolean" },
        "requiresVariables": { "type": "array", "items": { "type": "string" } }
      }
    },

    "CheckItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "id":          { "$ref": "#/$defs/Identifier" },
        "description": { "type": "string", "minLength": 1 },
        "required":    { "type": "boolean", "default": true }
      }
    },

    "ProcessVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Variable name usable in {key} placeholders."
        },
        "label":        { "type": "string", "minLength": 1 },
        "type":         { "enum": ["text", "select", "number"] },
        "required":     { "type": "boolean" },
        "placeholder":  { "type": "string" },
        "options":      { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "optionsFrom":  {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Name of a capturedVariable containing string[] to populate select options dynamically. Only valid for type: select."
        },
        "defaultValue": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
          "then": { "anyOf": [ { "required": ["options"] }, { "required": ["optionsFrom"] } ] }
        }
      ]
    },

    "SubprocessSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["github", "url", "local"] },
        "url":  { "type": "string" },
        "path": { "type": "string" },
        "ref":  { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["github", "url"] } }, "required": ["type"] },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "type": { "const": "local" } }, "required": ["type"] },
          "then": { "required": ["path"] }
        }
      ]
    },

    "Subprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id":        { "$ref": "#/$defs/Identifier" },
        "name":      { "type": "string", "minLength": 1 },
        "order":     { "type": "integer", "minimum": 0 },
        "source":    { "$ref": "#/$defs/SubprocessSource" },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "optional": { "type": "boolean" }
      }
    },

    "ActivityImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url"],
      "properties": {
        "id":      { "$ref": "#/$defs/Identifier" },
        "name":    { "type": "string", "minLength": 1 },
        "url":     { "type": "string", "format": "uri-reference" },
        "caption": { "type": "string" }
      }
    },

    "DynamicListConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label":           { "type": "string", "minLength": 1 },
        "placeholder":     { "type": "string" },
        "minItems":        { "type": "integer", "minimum": 0 },
        "maxItems":        { "type": "integer", "minimum": 1 },
        "allowDuplicates": { "type": "boolean" },
        "separators":      { "type": "array", "items": { "type": "string" } },
        "trimItems":       { "type": "boolean" }
      }
    },

    "DetailListConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTaskId"],
      "properties": {
        "sourceTaskId": { "$ref": "#/$defs/Identifier" },
        "placeholder":  { "type": "string" },
        "maxLength":    { "type": "integer", "minimum": 1 }
      }
    },

    "FormLayoutConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type":    { "enum": ["vertical", "grid"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
        "gap":     { "enum": ["small", "medium", "large"] }
      }
    },

    "FormFieldConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "required"],
      "properties": {
        "id":       { "$ref": "#/$defs/Identifier" },
        "label":    { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["text", "number", "email", "date", "time", "datetime", "boolean", "textarea", "image", "select"]
        },
        "required":        { "type": "boolean" },
        "placeholder":     { "type": "string" },
        "maxLength":       { "type": "integer", "minimum": 1 },
        "minLength":       { "type": "integer", "minimum": 0 },
        "defaultValue":    {},
        "options":         { "type": "array", "items": { "type": "string" } },
        "maxImages":       { "type": "integer", "minimum": 1 },
        "colSpan":         { "type": "integer", "minimum": 1, "maximum": 4 },
        "description":     { "type": "string" },
        "descriptionCell": { "type": "string", "description": "Excel cell or offset expression like 'F85-1'." },
        "valueCell":       { "$ref": "#/$defs/CellRef" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": { "type": "string" },
            "min":     { "type": "number" },
            "max":     { "type": "number" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
          "then": { "required": ["options"] }
        }
      ]
    },

    "FormConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "fields"],
      "properties": {
        "layout": { "$ref": "#/$defs/FormLayoutConfig" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FormFieldConfig" }
        }
      }
    },

    "DetailTableColumnConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "required"],
      "properties": {
        "id":       { "$ref": "#/$defs/Identifier" },
        "label":    { "type": "string", "minLength": 1, "description": "Column header. Supports #CELL# syntax (e.g. '#H46#') to read from template." },
        "type":     { "enum": ["boolean", "text", "date", "list", "computed-text"] },
        "required": { "type": "boolean" },
        "options":  { "type": "array", "items": { "type": "string" }, "description": "Options for type: list columns." },
        "template": { "type": "string", "description": "Template for type: computed-text. Supports {item}, {vars.xxx}." }
      }
    },

    "DetailTableConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceTaskId": { "$ref": "#/$defs/Identifier", "description": "ID of a dynamic-list task to use as row source." },
        "sourceVar":    {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Name of a capturedVariable containing string[] to use as row source (alternative to sourceTaskId)."
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/DetailTableColumnConfig" }
        }
      },
      "anyOf": [
        { "required": ["sourceTaskId"] },
        { "required": ["sourceVar"] }
      ]
    },

    "TaskOutputVar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "source"],
      "properties": {
        "name":  {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Variable name in capturedVariables."
        },
        "type":  { "enum": ["text", "list", "object"], "description": "text=string, list=string[], object=JSON string" },
        "source": { "type": "string", "description": "Dot-notation path on TaskState (e.g. listData, evidence.text, formData)." },
        "mapTo":  { "type": "string", "description": "For type: list, property to extract from each item (e.g. 'value')." }
      }
    },

    "ExportTaskSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mapping"],
          "properties": {
            "kind":    { "const": "variables" },
            "mapping": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/CellRef" },
              "description": "Map of variable key -> Excel cell reference."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cells"],
          "properties": {
            "kind":  { "const": "static" },
            "cells": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Z]+[0-9]+$" },
              "additionalProperties": { "type": ["string", "number", "boolean"] },
              "description": "Literal values keyed by cell reference."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind":              { "const": "time" },
            "today":             { "$ref": "#/$defs/CellRef" },
            "startedAt":         { "$ref": "#/$defs/CellRef" },
            "completedAt":       { "$ref": "#/$defs/CellRef" },
            "totalElapsedMinutes": { "$ref": "#/$defs/CellRef" },
            "totalElapsedHours":   { "$ref": "#/$defs/CellRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind":    { "const": "process" },
            "id":      { "$ref": "#/$defs/CellRef" },
            "name":    { "$ref": "#/$defs/CellRef" },
            "version": { "$ref": "#/$defs/CellRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cell"],
          "properties": {
            "kind":     { "const": "comments" },
            "cell":     { "$ref": "#/$defs/CellRef" },
            "template": { "type": "string", "description": "Interpolable text with {process.name}, {vars.xxx}, {today:FMT}." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceTaskId", "column", "startRow"],
          "properties": {
            "kind":         { "const": "list" },
            "sourceTaskId": { "$ref": "#/$defs/Identifier" },
            "column":       { "$ref": "#/$defs/ColumnLetter" },
            "startRow":     { "type": "integer", "minimum": 1 },
            "endRow":       { "type": "integer", "minimum": 1 },
            "maxItems":     { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceTaskId", "sections"],
          "properties": {
            "kind":         { "const": "detail" },
            "sourceTaskId": { "$ref": "#/$defs/Identifier" },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["column", "startRow"],
                "properties": {
                  "column":   { "$ref": "#/$defs/ColumnLetter" },
                  "startRow": { "type": "integer", "minimum": 1 },
                  "endRow":   { "type": "integer", "minimum": 1 },
                  "maxItems": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceTaskId"],
          "properties": {
            "kind":         { "const": "form" },
            "sourceTaskId": { "$ref": "#/$defs/Identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "startRow", "columns"],
          "properties": {
            "kind":         { "const": "checklist" },
            "sourceTaskId": { "$ref": "#/$defs/Identifier" },
            "startRow":     { "type": "integer", "minimum": 1 },
            "maxRows":      { "type": "integer", "minimum": 1 },
            "columns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "aplica":   { "$ref": "#/$defs/ColumnLetter" },
                "validado": { "$ref": "#/$defs/ColumnLetter" },
                "url":      { "$ref": "#/$defs/ColumnLetter" },
                "nombre":   { "$ref": "#/$defs/ColumnLetter" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceTaskId", "startRow", "columns"],
          "properties": {
            "kind":         { "const": "detail-table" },
            "sourceTaskId": { "$ref": "#/$defs/Identifier" },
            "startRow":     { "type": "integer", "minimum": 1 },
            "columns": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/ColumnLetter" },
              "description": "Map of detailTableConfig column id -> Excel column letter."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceTaskId", "fields"],
          "properties": {
            "kind":         { "const": "cell" },
            "sourceTaskId": { "$ref": "#/$defs/Identifier" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "cell"],
                "properties": {
                  "field": { "type": "string", "description": "Dot-notation path on TaskState (e.g. evidence.text, checkItems.<id>.checked)." },
                  "cell":  { "$ref": "#/$defs/CellRef" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "range", "outputVar"],
          "properties": {
            "kind":      { "const": "range" },
            "range":     {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]+:[A-Z]+[0-9]+$",
              "description": "Excel range in A1:B2 notation. Reads cell values from template."
            },
            "outputVar": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Name of capturedVariable to store the read values."
            },
            "flatten":   {
              "type": "boolean",
              "default": true,
              "description": "true=string[] (non-empty values), false=string[][] (full matrix)."
            }
          }
        }
      ]
    },

    "ExportSheetSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet"],
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the Excel worksheet this section targets."
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExportTaskSource" },
          "description": "Ordered list of data sources to apply to this sheet."
        },
        "startRow":          { "type": "integer", "minimum": 1, "description": "For evidence sheets: first data row." },
        "timestampColumn":   { "$ref": "#/$defs/ColumnLetter", "description": "For evidence sheets: column for timestamps." },
        "nameColumn":        { "$ref": "#/$defs/ColumnLetter", "description": "For evidence sheets: column for activity names." },
        "maxRows":           { "type": "integer", "minimum": 1, "description": "For evidence sheets: max rows to write." }
      }
    },

    "ProcessExportMappings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheets": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExportSheetSection" },
          "description": "Array of sheet sections, each declaring a target sheet and its data sources."
        }
      }
    },

    "ProcessExportConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templatePath"],
      "properties": {
        "templatePath":    { "type": "string", "minLength": 1 },
        "templateVersion": { "type": "string" },
        "templateSha256":  { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "outputFilename":  { "type": "string" },
        "autoDownload":    { "type": "boolean" },
        "mappings":        { "$ref": "#/$defs/ProcessExportMappings" }
      }
    },

    "ExportExcelConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templatePath":   { "type": "string" },
        "outputFilename": { "type": "string" },
        "autoDownload":   { "type": "boolean" },
        "inherit":        { "type": "boolean" },
        "mappings":       { "$ref": "#/$defs/ProcessExportMappings" }
      }
    },

    "TaskBase": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id":           { "$ref": "#/$defs/Identifier" },
        "name":         { "type": "string", "minLength": 1 },
        "description":  { "type": "string" },
        "order":        { "type": "integer", "minimum": 0 },
        "type": {
          "enum": ["standard", "check", "multicheck", "export-excel", "dynamic-list", "detail-list", "detail-table", "form"],
          "default": "standard"
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reference" }
        },
        "evidence":     { "$ref": "#/$defs/EvidenceConfig" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "dynamicLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/DynamicLink" }
        },
        "completionAlert": { "$ref": "#/$defs/CompletionAlert" },
        "outputVars": {
          "type": "array",
          "items": { "$ref": "#/$defs/TaskOutputVar" },
          "description": "Variables to write into capturedVariables when this task completes."
        }
      }
    },

    "CompletionAlert": {
      "type": "object",
      "description": "Optional confirmation dialog shown before finalizing the task.",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["info", "warning", "critical"],
          "default": "info",
          "description": "Drives icon, color palette and visual emphasis."
        },
        "title":        { "type": "string", "minLength": 1 },
        "description":  { "type": "string", "minLength": 1 },
        "confirmLabel": { "type": "string", "minLength": 1 },
        "cancelLabel":  { "type": "string", "minLength": 1 }
      }
    },

    "Task": {
      "allOf": [
        { "$ref": "#/$defs/TaskBase" },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": { "enum": ["standard", null] },
                "checkItem":    false,
                "checkItems":   false,
                "exportConfig": false,
                "listConfig":   false,
                "detailConfig": false,
                "formConfig":   false
              }
            },
            {
              "type": "object",
              "required": ["type", "checkItem"],
              "properties": {
                "type":       { "const": "check" },
                "checkItem":  { "$ref": "#/$defs/CheckItem" },
                "checkItems": false
              }
            },
            {
              "type": "object",
              "required": ["type", "checkItems"],
              "properties": {
                "type": { "const": "multicheck" },
                "checkItems": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/CheckItem" }
                },
                "checkItem": false
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type":         { "const": "export-excel" },
                "exportConfig": { "$ref": "#/$defs/ExportExcelConfig" }
              }
            },
            {
              "type": "object",
              "required": ["type", "listConfig"],
              "properties": {
                "type":       { "const": "dynamic-list" },
                "listConfig": { "$ref": "#/$defs/DynamicListConfig" }
              }
            },
            {
              "type": "object",
              "required": ["type", "detailConfig"],
              "properties": {
                "type":         { "const": "detail-list" },
                "detailConfig": { "$ref": "#/$defs/DetailListConfig" }
              }
            },
            {
              "type": "object",
              "required": ["type", "formConfig"],
              "properties": {
                "type":       { "const": "form" },
                "formConfig": { "$ref": "#/$defs/FormConfig" }
              }
            },
            {
              "type": "object",
              "required": ["type", "detailTableConfig"],
              "properties": {
                "type":              { "const": "detail-table" },
                "detailTableConfig": { "$ref": "#/$defs/DetailTableConfig" }
              }
            }
          ]
        }
      ]
    },

    "Activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "tasks"],
      "properties": {
        "id":           { "$ref": "#/$defs/Identifier" },
        "name":         { "type": "string", "minLength": 1 },
        "description":  { "type": "string" },
        "order":        { "type": "integer", "minimum": 0 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Task" }
        },
        "dynamicLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/DynamicLink" }
        },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActivityImage" }
        }
      }
    },

    "Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order"],
      "properties": {
        "id":           { "$ref": "#/$defs/Identifier" },
        "name":         { "type": "string", "minLength": 1 },
        "description":  { "type": "string" },
        "order":        { "type": "integer", "minimum": 0 },
        "activities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Activity" }
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/Task" }
        },
        "dynamicLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/DynamicLink" }
        }
      },
      "anyOf": [
        { "required": ["activities"], "properties": { "activities": { "minItems": 1 } } },
        { "required": ["tasks"],      "properties": { "tasks":      { "minItems": 1 } } }
      ]
    },

    "Process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "version", "phases"],
      "properties": {
        "id":            { "$ref": "#/$defs/Identifier" },
        "name":          { "type": "string", "minLength": 1 },
        "description":   { "type": "string" },
        "version":       { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$", "description": "Semantic Version (MAJOR.MINOR.PATCH) with optional pre-release/build identifiers (e.g. '1.2.0-rc.1')." },
        "estimatedTime": { "$ref": "#/$defs/Duration" },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProcessVariable" }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Phase" }
        },
        "subprocesses": {
          "type": "array",
          "items": { "$ref": "#/$defs/Subprocess" }
        },
        "export": { "$ref": "#/$defs/ProcessExportConfig" }
      }
    }
  }
}
